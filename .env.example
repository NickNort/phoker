# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Public URL of the Midnight blackjack mini-app. iMessage cards need a URL the
# phone can reach — localhost will not work on device. Use a deployed origin
# or a tunnel (e.g. https://your-app.example.com).
GAME_URL=

# Optional for the live hackathon demo. Without these, the UI uses browser voice.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
